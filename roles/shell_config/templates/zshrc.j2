# =============================================================
#  VON ANSIBLE VERWALTET - Aenderungen hier gehen verloren.
#  Bearbeite stattdessen:
#    roles/shell_config/templates/zshrc.j2
#    group_vars/all.yml
# =============================================================

export ZSH="$HOME/.oh-my-zsh"

# Leer lassen: den Prompt macht Starship, nicht oh-my-zsh.
ZSH_THEME=""

plugins=({{ omz_plugins | join(' ') }})

source $ZSH/oh-my-zsh.sh

# --- History -------------------------------------------------
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY

# --- Aliases -------------------------------------------------
# Ubuntu benennt zwei Binaries um - hier wieder geradegerueckt.
alias cat='batcat --paging=never'
alias bat='batcat'
alias fd='fdfind'
alias ls='eza --group-directories-first'
alias ll='eza -lah --group-directories-first --git'
alias lt='eza --tree --level=2'

alias k='kubectl'
alias gs='git status -sb'

# --- PATH ----------------------------------------------------
export PATH="$HOME/.local/bin:$PATH"

# --- Editor --------------------------------------------------
export EDITOR="${EDITOR:-vim}"

{% if setup_tmux %}
# --- tmux ----------------------------------------------------
alias t='tmux new-session -A -s main'
{% endif %}

# =============================================================
#  Starship MUSS als Letztes kommen.
#  Alles, was danach einen Prompt setzt, wuerde ihn ueberschreiben.
# =============================================================
eval "$(starship init zsh)"
