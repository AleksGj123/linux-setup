# VON ANSIBLE VERWALTET - siehe roles/tmux/templates/tmux.conf.j2

set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",xterm-256color:Tc"
set -g mouse on
set -g base-index 1
setw -g pane-base-index 1
set -sg escape-time 10

set -g status-position top

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'fabioluciano/tmux-powerkit'

set -g @powerkit_theme "catppuccin"
set -g @powerkit_separator_style "rounded"
set -g @powerkit_plugins "hostname,git,datetime"

# tpm MUSS als Letztes stehen.
run '~/.tmux/plugins/tpm/tpm'
